    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="Tiempo, Distancia, Velocidad" type="Real" array="False" size=""/>
            <output expression="&quot;Cual es la diistancia&quot;" newline="True"/>
            <input variable="Distancia"/>
            <output expression="&quot;Cual es la velocidad&quot;" newline="True"/>
            <input variable="Velocidad"/>
            <assign variable="Tiempo" expression="Distancia / Velocidad"/>
            <output expression="&quot; se demorara &quot; &amp; Tiempo &amp; &quot; hora&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
