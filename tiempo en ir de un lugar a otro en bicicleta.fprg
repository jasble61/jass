<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="tiempo en ir de un lugar a otro en bicicleta"/>
        <attribute name="authors" value="RYZEN 3"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-04-24 07:10:07 p.&#160;m."/>
